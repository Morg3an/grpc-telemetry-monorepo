{
  "name": "gateway",
  "version": "1.0.0",
  "description": "Node.js TypeScript API Gateway communicating with Python data-service over gRPC",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "node --test --import tsx src/test/gateway.test.ts"
  },
  "keywords": [
    "grpc",
    "protocol-buffers",
    "gateway",
    "express",
    "typescript"
  ],
  "author": "Morg3an",
  "license": "MIT",
  "dependencies": {
    "@grpc/grpc-js": "^1.10.6",
    "@grpc/proto-loader": "^0.7.13",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.7",
    "supertest": "^6.3.4",
    "@types/supertest": "^6.0.2",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5"
  }
}
